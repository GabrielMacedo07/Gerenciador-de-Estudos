# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/gerenciador_estudos?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=seu_usuario
spring.datasource.password=sua_senha

# JPA/Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# Server Port
server.port=8080

# JWT Security - TROQUE ESTA CHAVE EM PRODUÇÃO
api.security.token.secret=sua-chave-secreta-aqui-minimo-256-bits

# Logging
logging.level.org.springframework.security=DEBUG
logging.level.br.com.universidade.gerenciador_de_estudos=DEBUG
